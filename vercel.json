{
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "item" },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|Slackbot|Discordbot|LinkedInBot|Pinterestbot|SkypeUriPreview|Applebot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/product-preview"
    }
  ]
}
